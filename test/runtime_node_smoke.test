<launch>
  <node pkg="periodic_sync"
        type="swarm_runtime_node"
        name="swarm_runtime_node"
        output="screen">
    <param name="team_id" value="test_team"/>
    <param name="session_id" value="smoke_session"/>
    <param name="task_id" value="smoke_task"/>
    <param name="self_id" value="uav_test"/>
    <param name="frequency_hz" value="20.0"/>
    <param name="poll_rate_hz" value="100.0"/>
    <param name="start_delay_s" value="0.05"/>
    <param name="auto_start" value="true"/>
  </node>

  <test test-name="runtime_node_smoke"
        pkg="periodic_sync"
        type="runtime_node_smoke_test"
        time-limit="10.0"/>
</launch>
